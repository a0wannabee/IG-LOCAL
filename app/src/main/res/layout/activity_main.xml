<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#FFFFFF">

    <TextView
        android:id="@+id/txt_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:text="@string/app_name"
        android:textSize="24sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/img_profile"

        android:layout_width="90dp"
        android:layout_height="90dp"
        android:layout_below="@id/txt_title"
        android:layout_alignParentStart="true"
        android:layout_marginTop="20dp"
        android:src="@drawable/img_profile"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no"/>

    <TextView
        android:id="@+id/txt_username"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/img_profile"
        android:layout_alignTop="@id/img_profile"
        android:layout_marginStart="16dp"
        android:text="@string/username"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txt_posts"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/txt_username"
        android:layout_toEndOf="@id/img_profile"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:text="@string/posts"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txt_followers"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/txt_username"
        android:layout_toEndOf="@id/txt_posts"
        android:layout_marginStart="35dp"
        android:layout_marginTop="12dp"
        android:text="@string/followers"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txt_following"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/txt_username"
        android:layout_toEndOf="@id/txt_followers"
        android:layout_marginStart="35dp"
        android:layout_marginTop="12dp"
        android:text="@string/following"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txt_post_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/txt_posts"
        android:layout_toEndOf="@id/img_profile"
        android:layout_marginStart="16dp"
        android:text="@string/post_label"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/txt_follower_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/txt_followers"
        android:layout_toEndOf="@id/txt_posts"
        android:layout_marginStart="35dp"
        android:text="@string/follower_label"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/txt_following_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/txt_following"
        android:layout_toEndOf="@id/txt_followers"
        android:layout_marginStart="35dp"
        android:text="@string/following_label"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/txt_bio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/img_profile"
        android:layout_marginTop="16dp"
        android:text="@string/bio"
        android:textSize="15sp" />

    <Button
        android:id="@+id/btn_edit"
        android:layout_width="160dp"
        android:layout_height="wrap_content"
        android:layout_below="@id/txt_bio"
        android:layout_alignParentStart="true"
        android:layout_marginTop="16dp"
        android:text="@string/edit_profile" />

    <Button
        android:id="@+id/btn_share"
        android:layout_width="160dp"
        android:layout_height="wrap_content"
        android:layout_below="@id/txt_bio"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="16dp"
        android:text="@string/share_profile" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/btn_edit"
        android:layout_marginTop="16dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/img_photo1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="centerCrop"
                android:src="@drawable/foto1"
                android:importantForAccessibility="no" />

            <ImageView
                android:id="@+id/img_photo2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:scaleType="centerCrop"
                android:src="@drawable/foto1"
                android:importantForAccessibility="no" />

            <ImageView
                android:id="@+id/img_photo3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:scaleType="centerCrop"
                android:src="@drawable/foto1"
                android:importantForAccessibility="no" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/img_photo4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="centerCrop"
                android:src="@drawable/foto1"
                android:importantForAccessibility="no" />

            <ImageView
                android:id="@+id/img_photo5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:scaleType="centerCrop"
                android:src="@drawable/foto1"
                android:importantForAccessibility="no" />

            <ImageView
                android:id="@+id/img_photo6"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:scaleType="centerCrop"
                android:src="@drawable/foto1"
                android:importantForAccessibility="no" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/img_photo7"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="centerCrop"
                android:src="@drawable/foto1"
                android:importantForAccessibility="no" />

            <ImageView
                android:id="@+id/img_photo8"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:scaleType="centerCrop"
                android:src="@drawable/foto1"
                android:importantForAccessibility="no" />

            <ImageView
                android:id="@+id/img_photo9"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:scaleType="centerCrop"
                android:src="@drawable/foto1"
                android:importantForAccessibility="no" />

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>